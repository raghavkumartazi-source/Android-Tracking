# BharatWatch Configuration
# Copy this file to .env and update the values

# Server port
PORT=3000

# Dashboard PIN (your father's access code)
DASHBOARD_PIN=1234

# Agent authentication key (must match the Android app config)
AGENT_KEY=bharatwatch-agent-secret-change-me

# Session secret (random string for session encryption)
SESSION_SECRET=change-me-to-a-random-string

# Database file path
DATABASE_PATH=./data/bharatwatch.db
